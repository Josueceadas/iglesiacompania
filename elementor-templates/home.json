            { "id": "hero0003", "elType": "widget", "widgetType": "html", "settings": { "html": "\u003cstyle\u003e\n.ihs-hero{font-family:Roboto,Helvetica,Arial,sans-serif;position:relative;min-height:620px;overflow:hidden;background:#4d0f19 url(\u0027https://i.ytimg.com/vi/feqprnyI7m0/hqdefault.jpg\u0027) center/cover no-repeat;display:flex;align-items:center;color:#faf6f0}\n.ihs-hero__bg{position:absolute;inset:0;overflow:hidden;pointer-events:none}\n.ihs-hero__bg iframe{position:absolute;top:50%;left:50%;width:max(100%,1102px);aspect-ratio:16/9;height:auto;border:0;transform:translate(-50%,-50%) scale(1.12);opacity:0;transition:opacity 1s}\n.ihs-hero__bg iframe.is-ready{opacity:1}\n.ihs-hero::after{content:\u0027\u0027;position:absolute;inset:0;background:linear-gradient(90deg,rgba(77,15,25,.92) 0%,rgba(77,15,25,.65) 50%,rgba(77,15,25,.25) 100%);pointer-events:none}\n.ihs-hero__in{position:relative;z-index:2;width:100%;max-width:1140px;margin:0 auto;padding:3rem 1.25rem}\n.ihs-hero__txt{max-width:560px}\n.ihs-hero__kicker{color:#c9a24b;text-transform:uppercase;letter-spacing:.12em;font-size:.8rem;font-weight:700;margin:0 0 .75rem}\n.ihs-hero h1{font-family:'Roboto Slab',Georgia,serif;font-weight:600;color:#fff;font-size:clamp(2rem,5vw,3.4rem);line-height:1.12;margin:0 0 1rem;text-shadow:0 2px 12px rgba(0,0,0,.35)}\n.ihs-hero__sub{font-size:1.15rem;margin:0 0 1.75rem;color:#f1e6d6}\n.ihs-hero__btns{display:flex;flex-wrap:wrap;gap:.9rem}\n.ihs-hero__btn{display:inline-flex;align-items:center;gap:.5rem;background:#c9a24b;color:#4d0f19;font-weight:700;padding:.8rem 1.6rem;border-radius:6px;text-decoration:none;border:2px solid #c9a24b;cursor:pointer;font-size:1rem;font-family:inherit;transition:background .2s,color .2s,transform .2s}\n.ihs-hero__btn:hover,.ihs-hero__btn:focus-visible{background:#fff;border-color:#fff;transform:translateY(-2px)}\n.ihs-hero__btn--ghost{background:transparent;color:#fff}\n.ihs-hero__btn--ghost:hover,.ihs-hero__btn--ghost:focus-visible{background:#c9a24b;border-color:#c9a24b;color:#4d0f19}\n.ihs-lb{position:fixed;inset:0;z-index:10000;background:rgba(20,5,8,.92);display:none;align-items:center;justify-content:center;padding:1.25rem}\n.ihs-lb.is-open{display:flex}\n.ihs-lb__box{position:relative;width:min(1100px,100%);aspect-ratio:16/9;background:#000;border:2px solid #c9a24b;border-radius:12px;overflow:hidden}\n.ihs-lb__box iframe{position:absolute;inset:0;width:100%;height:100%;border:0}\n.ihs-lb__x{position:absolute;top:1rem;right:1.25rem;background:#c9a24b;color:#4d0f19;border:0;border-radius:50%;width:44px;height:44px;font-size:1.6rem;line-height:1;cursor:pointer}\n@media (max-width:859px){.ihs-hero{min-height:560px}.ihs-hero::after{background:linear-gradient(180deg,rgba(77,15,25,.8),rgba(77,15,25,.7))}}\n@media (prefers-reduced-motion:reduce){.ihs-hero__bg{display:none}}\n\u003c/style\u003e\n\u003csection class=\u0027ihs-hero\u0027 aria-label=\u0027Bienvenida\u0027\u003e\n\u003cdiv class=\u0027ihs-hero__bg\u0027 aria-hidden=\u0027true\u0027 data-src=\u0027https://www.youtube-nocookie.com/embed/feqprnyI7m0?autoplay=1\u0026mute=1\u0026loop=1\u0026playlist=feqprnyI7m0\u0026controls=0\u0026modestbranding=1\u0026rel=0\u0026playsinline=1\u0026disablekb=1\u0026iv_load_policy=3\u0027\u003e\u003c/div\u003e\n\u003cdiv class=\u0027ihs-hero__in\u0027\u003e\u003cdiv class=\u0027ihs-hero__txt\u0027\u003e\n\u003cp class=\u0027ihs-hero__kicker\u0027\u003eCórdoba · Jesuitas ARU\u003c/p\u003e\n\u003ch1\u003eIglesia de la Compañía de Jesús\u003c/h1\u003e\n\u003cp class=\u0027ihs-hero__sub\u0027\u003eBienvenidos a nuestra comunidad.\u003c/p\u003e\n\u003cdiv class=\u0027ihs-hero__btns\u0027\u003e\n\u003ca class=\u0027ihs-hero__btn\u0027 href=\u0027#avisos\u0027\u003eVer avisos\u003c/a\u003e\n\u003cbutton type=\u0027button\u0027 class=\u0027ihs-hero__btn ihs-hero__btn--ghost\u0027 data-open-video\u003e\u003csvg width=\u002718\u0027 height=\u002718\u0027 viewBox=\u00270 0 24 24\u0027 fill=\u0027currentColor\u0027 aria-hidden=\u0027true\u0027\u003e\u003cpath d=\u0027M8 5v14l11-7z\u0027/\u003e\u003c/svg\u003eVer con sonido\u003c/button\u003e\n\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\n\u003cdiv class=\u0027ihs-lb\u0027 role=\u0027dialog\u0027 aria-modal=\u0027true\u0027 aria-label=\u0027Video: Iglesia de la Compañía de Jesús\u0027\u003e\u003cdiv class=\u0027ihs-lb__box\u0027\u003e\u003c/div\u003e\u003cbutton type=\u0027button\u0027 class=\u0027ihs-lb__x\u0027 aria-label=\u0027Cerrar video\u0027\u003e\u0026times;\u003c/button\u003e\u003c/div\u003e\n\u003c/section\u003e\n\u003cscript\u003e(function(){var h=document.currentScript.previousElementSibling;var bg=h.querySelector(\u0027.ihs-hero__bg\u0027),lb=h.querySelector(\u0027.ihs-lb\u0027),box=h.querySelector(\u0027.ihs-lb__box\u0027);\nif(!window.matchMedia(\u0027(prefers-reduced-motion: reduce)\u0027).matches){var i=document.createElement(\u0027iframe\u0027);i.src=bg.dataset.src;i.title=\u0027\u0027;i.tabIndex=-1;i.allow=\u0027autoplay; encrypted-media\u0027;i.onload=function(){setTimeout(function(){i.classList.add(\u0027is-ready\u0027)},1200)};bg.appendChild(i);}\nfunction open(){box.innerHTML=\u0027\u003ciframe src=\"https://www.youtube-nocookie.com/embed/feqprnyI7m0?autoplay=1\u0026rel=0\" title=\"Iglesia de la Compañía de Jesús, Córdoba\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen\u003e\u003c/iframe\u003e\u0027;lb.classList.add(\u0027is-open\u0027);if(bg.firstChild)bg.firstChild.remove();}\nfunction close(){lb.classList.remove(\u0027is-open\u0027);box.innerHTML=\u0027\u0027;if(!bg.firstChild\u0026\u0026!window.matchMedia(\u0027(prefers-reduced-motion: reduce)\u0027).matches){var i=document.createElement(\u0027iframe\u0027);i.src=bg.dataset.src;i.title=\u0027\u0027;i.tabIndex=-1;i.allow=\u0027autoplay; encrypted-media\u0027;i.className=\u0027is-ready\u0027;bg.appendChild(i);}}\nh.querySelector(\u0027[data-open-video]\u0027).addEventListener(\u0027click\u0027,open);h.querySelector(\u0027.ihs-lb__x\u0027).addEventListener(\u0027click\u0027,close);\nlb.addEventListener(\u0027click\u0027,function(e){if(e.target===lb)close()});document.addEventListener(\u0027keydown\u0027,function(e){if(e.key===\u0027Escape\u0027\u0026\u0026lb.classList.contains(\u0027is-open\u0027))close()});})();\u003c/script\u003e" }, "elements": [] }
